APP_NAME="Policía Boliviana"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Secure cookies are enabled automatically when APP_ENV=production. Set this
# explicitly only when serving over HTTPS in another environment.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===== IA LOCAL (LM Studio) — Verificación documental con visión =====
# Servidor: LM Studio corriendo en http://127.0.0.1:1234
IA_URL=http://127.0.0.1:1234
IA_ENDPOINT=/api/v1/chat
#
# MODELO RECOMENDADO: Qwen2.5-VL 3B Instruct (~3.3 GB, entra completo en 4 GB
# de VRAM). Descarga en LM Studio:
#   lms get https://huggingface.co/lmstudio-community/Qwen2.5-VL-3B-Instruct-GGUF -y
# y cárguelo (dejarlo cargado evita ~10 s de carga en la 1ª consulta):
#   lms load qwen2.5-vl-3b-instruct --gpu max --context-length 4096 --parallel 1 --ttl 3600 -y
# Use el IDENTADOR que muestra `lms ls` (no el nombre del archivo del Hub).
IA_MODEL=qwen2.5-vl-3b-instruct
# Un solo modelo para todos los flujos: intercambiar modelos en caliente obliga
# a LM Studio a recargar pesos y es lo que producía esperas de minutos.
IA_MODEL_RAPIDO=qwen2.5-vl-3b-instruct
# Vacío a propósito: cargar un segundo modelo saca de la VRAM al 3B (con 4 GB
# el 7B cae a CPU y cada consulta pasa de ~4 s a ~20 s). Si el 3B no está
# descargado, el servicio elige solo otro modelo de visión disponible.
IA_MODEL_FALLBACK=
# Filtro de encabezado: si el documento no dice MEMORÁNDUM se descarta al
# instante (en rojo) y no se gasta ninguna consulta de visión.
IA_GATE_MEMO=true
# Pre-filtro del encabezado por imagen en escaneos: OFF a propósito (duplica
# trabajo y la lectura completa ya decide el tipo).
IA_GATE_VISION=false
IA_ESPERAR_SIN_LIMITE=true
IA_CACHE_LECTURA_SEGUNDOS=900
# Tope de SEGURIDAD de la verificación completa, en segundos. Amplio a
# propósito: la IA tarda lo que necesite; esto solo evita peticiones colgadas.
IA_PRESUPUESTO=300
IA_TIMEOUT=240
IA_TIMEOUT_FALLBACK=300
IA_TIMEOUT_MAXIMO=300
IA_MAX_PAGINAS=1
# Se rasteriza a 150 DPI (nítido) y se reduce a IA_MAX_LADO con LANCZOS: mejor
# OCR que rasterizar a baja resolución con los mismos tokens.
IA_DPI=150
# Lado mayor de la imagen enviada al modelo. tokens ≈ (ancho/56)·(alto/56).
IA_MAX_LADO=1280
IA_MAX_LADO_ENCABEZADO=900
# Tope de tokens de salida. Amplio a propósito: truncar el JSON lo invalida;
# la generación se detiene sola al cerrarlo, así que el techo no cuesta latencia.
IA_MAX_TOKENS=400
IA_MAX_TOKENS_ENCABEZADO=120
# Tope de espera del pre-filtro del encabezado (franja superior del PDF)
IA_TIMEOUT_ENCABEZADO=20
# Cola FIFO del registro público
IA_COLA_LOTE=10
IA_COLA_PAUSA=3

# Exportación de reportes por rol. Python debe tener scripts/requirements-reportes.txt.
REPORTES_PYTHON=python
REPORTES_COMANDO_DEPARTAMENTAL_ID=1
